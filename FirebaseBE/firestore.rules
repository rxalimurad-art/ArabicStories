rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Daily Checklist (native, owner-only) ──────────────────────────────
    // Personal checklist now lives in the Quran Rifqah app (the public PWA was
    // removed). Only the owner's account can read/write; Cloud Functions use the
    // Admin SDK and bypass these rules. Docs are tiny ({taskKey,date,done,note}).
    match /checklist_entries/{docId} {
      allow read, write: if request.auth != null
        && request.auth.uid == 'Y5tVDGDvPMST5fqy9YGBhRneGyU2';
    }

    // ── User profiles & data ──────────────────────────────────────────────
    // /users/{uid}           — profile doc + streak/settings fields
    // /users/{uid}/sessions  — reading sessions
    // /users/{uid}/activity  — daily activity logs

    match /users/{uid} {
      // Any authenticated user can read profiles (friend discovery)
      allow read: if request.auth != null;
      // Only the owner can write their own document
      allow write: if request.auth != null && request.auth.uid == uid;

      match /sessions/{sessionId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      match /activity/{activityId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // ── Bayan app: user profiles, sessions, activity ─────────────────────
    // /bayan_users/{uid}                    — profile doc
    // /bayan_users/{uid}/sessions/{id}      — reading sessions
    // /bayan_users/{uid}/activity/{id}      — daily activity logs

    match /bayan_users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;

      match /sessions/{sessionId} {
        // Any signed-in user can read (friend profile: current reading + sessions);
        // only the owner can write their own.
        allow read:  if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == uid;
      }

      match /activity/{actId} {
        // Any signed-in user can read activity (friends' stats + leaderboard);
        // only the owner can write their own.
        allow read:  if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == uid;
      }

      match /remember_groups/{groupId} {
        // Memorisation is private to the owner (not shared with friends).
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // ── Bayan: friend requests ────────────────────────────────────────────
    match /bayan_friend_requests/{requestId} {
      allow read: if request.auth != null &&
        (resource.data.fromUserId == request.auth.uid ||
         resource.data.toUserId   == request.auth.uid);
      allow create: if request.auth != null &&
        request.resource.data.fromUserId == request.auth.uid &&
        request.resource.data.status == "pending";
      allow update: if request.auth != null &&
        resource.data.toUserId == request.auth.uid &&
        request.resource.data.status in ["accepted", "declined"];
      allow delete: if request.auth != null &&
        (resource.data.fromUserId == request.auth.uid ||
         resource.data.toUserId   == request.auth.uid);
    }

    // ── Bayan: conversations ──────────────────────────────────────────────
    match /bayan_conversations/{convId} {
      allow read, write: if request.auth != null && isParticipant(convId);

      match /messages/{messageId} {
        allow read: if request.auth != null && isParticipant(convId);
        allow create: if request.auth != null &&
          isParticipant(convId) &&
          request.resource.data.fromUserId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // ── Bayan: user reports (moderation) ──────────────────────────────────
    // Users can file reports; only moderators (Admin SDK) read/act on them.
    match /bayan_reports/{reportId} {
      allow create: if request.auth != null &&
        request.resource.data.reporterId == request.auth.uid;
      allow read, update, delete: if false;
    }

    // ── Bayan: device tokens (FCM) ────────────────────────────────────────
    // Each user owns their token doc; the Cloud Function reads via Admin SDK
    // (which bypasses rules), so no cross-user read is needed here.
    match /bayan_device_tokens/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ── Friend requests ───────────────────────────────────────────────────
    // /friend_requests/{requestId}
    // Fields: fromUserId, toUserId, status, createdAt

    match /friend_requests/{requestId} {
      // Read: either party in the request
      allow read: if request.auth != null &&
        (resource.data.fromUserId == request.auth.uid ||
         resource.data.toUserId   == request.auth.uid);

      // Create: sender must be the authenticated user, status must be "pending"
      allow create: if request.auth != null &&
        request.resource.data.fromUserId == request.auth.uid &&
        request.resource.data.status == "pending";

      // Update: only the recipient can accept/decline
      allow update: if request.auth != null &&
        resource.data.toUserId == request.auth.uid &&
        request.resource.data.status in ["accepted", "declined"];

      // Delete: either party can remove (unfriend / cancel request)
      allow delete: if request.auth != null &&
        (resource.data.fromUserId == request.auth.uid ||
         resource.data.toUserId   == request.auth.uid);
    }

    // ── Conversations / messages ──────────────────────────────────────────
    // /conversations/{convId}               — conversation metadata
    // /conversations/{convId}/messages/{id} — individual messages
    //
    // convId = [uid1, uid2].sorted().joined(separator: "_")

    function isParticipant(convId) {
      let parts = convId.split("_");
      return request.auth.uid in parts;
    }

    match /conversations/{convId} {
      allow read, write: if request.auth != null && isParticipant(convId);

      match /messages/{messageId} {
        allow read: if request.auth != null && isParticipant(convId);
        allow create: if request.auth != null &&
          isParticipant(convId) &&
          request.resource.data.fromUserId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // ── Device tokens (FCM) ───────────────────────────────────────────────
    // /device_tokens/{uid}

    match /device_tokens/{uid} {
      allow read:  if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
